# NOT an install script. Do not overwrite an existing server block or nginx.conf.
# Replace the reserved domain and both certificate paths AFTER inspecting the server.
server {
    listen 80;
    server_name social.example.invalid;
    return 308 https://social.example.invalid$request_uri;
}

server {
    listen 443 ssl;
    server_name social.example.invalid;
    ssl_certificate /REPLACE_WITH_EXISTING_CERT/fullchain.pem;
    ssl_certificate_key /REPLACE_WITH_EXISTING_CERT/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 32k;

    # Avoid recording usernames supplied in search query strings.
    access_log off;
    error_log /var/log/nginx/nihongomate-social-error.log warn;

    location /api/ {
        # No trailing slash: retain the /api/... prefix expected by FastAPI.
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Overwrite client-supplied forwarding headers; Uvicorn trusts only loopback.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
        proxy_cache off;
        add_header Cache-Control "no-store" always;
        # CORS belongs to FastAPI; do not add a wildcard or duplicate CORS headers.
    }

    # Keep /docs and other routes private; the phone only needs /api/.
    location / {
        return 404;
    }
}

